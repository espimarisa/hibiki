{
  "name": "@espimarisa/hibiki",
  "version": "4.0.0-alpha.1",
  "private": true,
  "description": "A Discord bot with polished community and developer tools.",
  "homepage": "https://github.com/espimarisa/hibiki",
  "bugs": {
    "url": "https://github.com/espimarisa/hibiki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:espimarisa/hibiki.git"
  },
  "license": "zlib",
  "author": {
    "name": "Espi Marisa",
    "email": "contact@espi.me",
    "url": "https://espi.me"
  },
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "check": "bun run db:generate && tsc --noEmit",
    "db:generate": "bun run drizzle-kit generate",
    "db:migrate": "bun run drizzle-kit migrate",
    "db:push": "bun run drizzle-kit push",
    "db:studio": "bun run drizzle-kit studio",
    "dev": "NODE_ENV=DEVELOPMENT bun run db:generate && bun run ./src/index.ts",
    "dev:register": "NODE_ENV=DEVELOPMENT bun run ./src/register.ts",
    "dev:register:clear": "NODE_ENV=DEVELOPMENT bun run ./src/register.ts --clear",
    "format": "biome format --fix .",
    "lint": "biome check .",
    "lint:fix": "biome lint --fix .",
    "register": "NODE_ENV=PRODUCTION bun run ./src/register.ts",
    "register:clear": "NODE_ENV=PRODUCTION bun run ./src/register.ts --clear",
    "start": "NODE_ENV=PRODUCTION bun run ./src/index.ts",
    "test": "NODE_ENV=TEST bun run check && bun run lint"
  },
  "dependencies": {
    "@sentry/bun": "^9.19.0",
    "discord.js": "^14.19.3",
    "drizzle-orm": "^0.43.1",
    "i18next": "^25.1.3",
    "i18next-fs-backend": "^2.6.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^3.1.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0-beta.4",
    "@types/bun": "^1.2.13",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.8.3"
  },
  "packageManager": "bun@1.2.13",
  "engines": {
    "bun": ">=1.2.13"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild"
  ]
}
