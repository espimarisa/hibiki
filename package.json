{
	"name": "@espimarisa/hibiki",
	"version": "4.0.0-alpha",
	"type": "module",
	"description": "discord app providing informational tools and utilities",
	"author": "Espi Marisa <contact@espi.me> (https://espi.me)",
	"license": "zlib",
	"private": true,
	"packageManager": "bun@1.2.5",
	"scripts": {
		"check": "tsc --noEmit",
		"deploy": "NODE_ENV=production bun run ./src/register.ts",
		"deploy:dev": "NODE_ENV=development bun run ./src/register.ts",
		"dev": "NODE_ENV=development bun run --hot ./src/index.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --apply .",
		"start": "bun run deploy && bun run start",
		"start:bot": "NODE_ENV=production bun run ./src/index.ts",
		"test": "bun run check && bun run lint",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@discordeno/bot": "^21.0.0",
		"@discordeno/types": "^21.0.0",
		"@discordeno/utils": "^21.0.0",
		"@sentry/bun": "^9.8.0",
		"dd-cache-proxy": "^2.6.0",
		"i18xs": "^1.5.4",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bun": "^1.2.5",
		"typescript": "^5.8.2"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild"
	]
}
