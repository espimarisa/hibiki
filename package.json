{
	"name": "@espimarisa/hibiki",
	"version": "5.0.0-alpha",
	"type": "module",
	"description": "discord app providing informational tools and utilities",
	"author": "Espi Marisa <contact@espi.me> (https://espi.me)",
	"license": "zlib",
	"private": true,
	"packageManager": "bun@1.2.5",
	"scripts": {
		"check": "tsc --noEmit",
		"dev": "NODE_ENV=development bun run --hot ./src/index.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --apply .",
		"start": "NODE_ENV=production bun run ./src/index.ts",
		"test": "bun run check && bun run lint",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@discordjs/rest": "^2.4.3",
		"@tsed/logger": "^7.0.2",
		"discord.js": "^14.18.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"bun-types": "^1.2.5",
		"typescript": "^5.8.2"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild"
	]
}
