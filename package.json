{
	"private": true,
	"name": "@espimarisa/hibiki",
	"version": "4.0.0-alpha",
	"description": "discord app providing informational tools and utilities",
	"license": "zlib",
	"author": "Espi Marisa <contact@espi.me> (https://espi.me)",
	"homepage": "https://github.com/espimarisa/hibiki",
	"repository": "git@github.com:espimarisa/hibiki.git",
	"bugs": "https://github.com/espimarisa/hibiki/issues",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"check": "tsc --noEmit",
		"dev": "NODE_ENV=development bun run ./src/index.ts",
		"format": "biome format --fix .",
		"lint": "biome check",
		"lint:fix": "biome lint --fix .",
		"start": "NODE_ENV=production bun run ./src/index.ts",
		"test": "bun run check && bun run lint"
	},
	"dependencies": {
		"@sentry/bun": "^9.10.1",
		"i18next": "^24.2.3",
		"i18next-fs-backend": "^2.6.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.0.0-beta.1",
		"@types/bun": "^1.2.8",
		"turbo": "^2.4.4",
		"typescript": "^5.8.2"
	},
	"packageManager": "bun@1.2.7",
	"trustedDependencies": ["@biomejs/biome", "esbuild"]
}
