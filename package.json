{
  "name": "@espimarisa/hibiki",
  "version": "4.0.0-alpha.1",
  "private": true,
  "description": "A Discord bot with polished community, development, and informational tools.",
  "homepage": "https://github.com/espimarisa/hibiki",
  "bugs": {
    "url": "https://github.com/espimarisa/hibiki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:espimarisa/hibiki.git"
  },
  "license": "zlib",
  "author": {
    "name": "Espi Marisa",
    "email": "contact@espi.me",
    "url": "https://espi.me"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "scripts": {
    "build": "rm -rf dist && bun run db:generate && tsc",
    "check": "bun run db:generate && tsc --noEmit",
    "db:generate": "bun drizzle-kit generate",
    "db:migrate": "bun drizzle-kit migrate",
    "db:push": "bun drizzle-kit push",
    "dev": "NODE_ENV=development bun db:push && bun run src/index.ts",
    "dev:register": "NODE_ENV=development bun run src/register.ts",
    "dev:register:clear": "NODE_ENV=development bun run src/register.ts --clear",
    "format": "biome format --fix .",
    "lint": "biome check .",
    "lint:fix": "biome lint --fix .",
    "register": "NODE_ENV=production bun run dist/src/register.js",
    "register:clear": "NODE_ENV=production bun run dist/src/register.js --clear",
    "start": "NODE_ENV=production bun run dist/src/index.js",
    "test": "NODE_ENV=development bun run check && bun run lint"
  },
  "dependencies": {
    "@chatsift/pino-rotate-file": "^0.5.1",
    "@sentry/bun": "^9.14.0",
    "date-fns": "^4.1.0",
    "discord.js": "^14.19.1",
    "drizzle-orm": "^0.43.1",
    "i18next": "^25.0.1",
    "i18next-fs-backend": "^2.6.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "tslib": "^2.8.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0-beta.1",
    "@types/bun": "^1.2.10",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "bun@1.2.10",
  "engines": {
    "bun": ">=1.2.10"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild"
  ]
}
