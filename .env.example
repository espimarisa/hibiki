#################################################################################################
# An example Hibiki configuration file.	To generate a valid auth hex, run the following below:  #
# bun -e "import crypto from 'crypto'; console.log(crypto.randomBytes(64).toString(('hex')));"  #
#################################################################################################

DISCORD_TOKEN = ""                        # Discord bot token to login to the Discord API.
DISCORD_GUILD_ID = ""                     # Discord Guild ID to deploy to in development mode. Optional.
DISCORD_STATUSES = "h, guh, read if cute" # Statuses to cycle through, delimited by a comma and a space. Optional.
SENTRY_DSN = ""                           # Sentry DSN URL to submit and upload errors to. Optional.
