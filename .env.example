#
# For more configuration information, see /src/utils/env.ts.

# REQUIRED: Discord bot token to authenticate with.
BOT_TOKEN = ""

# OPTIONAL: Comma-space delimited list (or a single) statuses to cycle through.
BOT_STATUSES = "read if cute, h, guh"

# OPTIONAL: Discord channel ID to log certain events to.
DEV_CHANNEL_ID = ""

# OPTIONAL: Discord guild ID to log certain events to.
DEV_GUILD_ID = ""

# OPTIONAL: Sentry.io DSN URL to upload errors to.
SENTRY_DSN = ""

# OPTIONAL: AbuseIPDB API key used for certain commands.
API_KEY_ABUSEIPDB = ""

# OPTIONAL: IPInfo.IO API key used for certain commands.
API_KEY_IPINFO = ""

# REQUIRED: PostgreSQL database to connect to.
POSTGRES_DB="postgres"

# REQUIRED: PostgreSQL host to connect to.
POSTGRES_HOST="127.0.0.1"

# REQUIRED: PostgreSQL password to authenticate with.
POSTGRES_PASSWORD="postgres"

# REQUIRED: PostgreSQL port to connect to (the host port).
POSTGRES_PORT=5432

# REQUIRED: PostgreSQL username to authenticate with.
POSTGRES_USER="postgres"

# REQUIRED: Valkey database password to authenticate with.
VALKEY_PASSWORD="valkey"

# REQUIRED: Valkey port to connect to.
VALKEY_PORT=6379

# REQUIRED: Valkey URL to authenticate with.
VALKEY_URL="valkey://valkey:${VALKEY_PORT}"
