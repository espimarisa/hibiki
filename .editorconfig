root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = tab
insert_final_newline = true
tab_width = 2
trim_trailing_whitespace = true

# Markdown should not have whitespace trimmed
[*.{md}]
trim_trailing_whitespace = false

# YAML requires 2 spaces
[*.{yml,yaml}]
indent_size = 2
indent_style = space
